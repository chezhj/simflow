# Copy to .env on the server (it is gitignored) and fill in.
# python-decouple reads this from the repo root or from
# smart_training_checklist/settings/. Production values live in
# ~/domains/shared/simflow/.env, which is symlinked into each release.

# ── Required in production ──────────────────────────────────────────────────
SECRET_KEY=

# ── Outbound mail ───────────────────────────────────────────────────────────
# On this cPanel host the local Exim listens on localhost:25 and accepts
# mailbox credentials, so these three are all that is needed. Everything else
# below keeps Django's own defaults.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
FROM_EMAIL=SimFlow <noreply@simflow.vdwaal.net>

# Only set these if mail is NOT going through the local MTA. A port that does
# not match the host's TLS mode is a silent delivery failure.
#EMAIL_HOST=localhost
#EMAIL_PORT=25
#EMAIL_USE_TLS=False      # True with port 587 (STARTTLS)
#EMAIL_USE_SSL=False      # True with port 465 (implicit TLS)
#EMAIL_TIMEOUT=10

# ── HTTPS hardening (see docs/PRE_RELEASE_PLAN.md phase 6) ───────────────────
# Enable only after confirming Django sees requests as secure; a wrong answer
# here is an infinite redirect loop that takes the site down.
#SECURE_SSL_REDIRECT=False
# Ramp: 3600 -> 86400 -> 604800 -> 31536000. Browsers honour it even if the
# certificate later lapses, which is why it ramps.
#SECURE_HSTS_SECONDS=0

# ── Dev only ────────────────────────────────────────────────────────────────
# Sent as X-Auth-Token to the SimBrief WireMock mock.
#X-Auth-Token=
