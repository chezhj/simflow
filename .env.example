# Copy to .env on the server (it is gitignored) and fill in.
# python-decouple reads this from the repo root or from
# smart_training_checklist/settings/. Production values live in
# ~/domains/shared/simflow/.env, which is symlinked into each release.

# ── Required in production ──────────────────────────────────────────────────
SECRET_KEY=

# ── Outbound mail ───────────────────────────────────────────────────────────
# Host/port/TLS default to mail.vdwaal.net:587 with STARTTLS, matching
# weekmenu's prod.py, so only these three are needed.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SimFlow <noreply@simflow.vdwaal.net>

# Only if mail moves off that host. Do NOT point this at localhost:25 with
# credentials set: Exim advertises no AUTH there even after STARTTLS, and
# Django calls login() whenever both are set, so every send raises
# SMTPNotSupportedError.
#EMAIL_HOST=mail.vdwaal.net
#EMAIL_PORT=587
#EMAIL_USE_TLS=True       # False with port 465, paired with EMAIL_USE_SSL=True
#EMAIL_USE_SSL=False
#EMAIL_TIMEOUT=10

# ── Error reporting ─────────────────────────────────────────────────────────
# Where unhandled 500s are mailed. Kept out of the repo because it is public.
# Leave empty and no error mail is sent — nothing breaks, you just hear nothing.
# Mail is sent inline in the failing request and is NOT throttled: a persistent
# error sends one message per request.
ADMIN_EMAIL=
# From address on error mail specifically; Django uses SERVER_EMAIL for those,
# not DEFAULT_FROM_EMAIL. Defaults to DEFAULT_FROM_EMAIL if unset.
#SERVER_EMAIL=

# ── HTTPS hardening (see docs/PRE_RELEASE_PLAN.md phase 6) ───────────────────
# Enable only after confirming Django sees requests as secure; a wrong answer
# here is an infinite redirect loop that takes the site down.
#SECURE_SSL_REDIRECT=False
# Ramp: 3600 -> 86400 -> 604800 -> 31536000. Browsers honour it even if the
# certificate later lapses, which is why it ramps.
#SECURE_HSTS_SECONDS=0

# ── Dev only ────────────────────────────────────────────────────────────────
# Sent as X-Auth-Token to the SimBrief WireMock mock.
#X-Auth-Token=
